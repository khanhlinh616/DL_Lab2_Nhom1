# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Datasets
data/*
!data/.gitkeep

# Checkpoints
checkpoints/*
!checkpoints/.gitkeep

# Tensorboard runs
runs/*
!runs/.gitkeep

# Outputs
outputs/metrics/*
outputs/figures/*
!outputs/metrics/.gitkeep
!outputs/figures/.gitkeep
!outputs/metrics/*.json
!outputs/metrics/*.csv
!outputs/figures/*.png

# Logs
logs/*.log
logs/*.log.*
!logs/.gitkeep

# Environment
.venv/
env/
venv/
.env

# IDE
.idea/
.vscode/
*.swp
